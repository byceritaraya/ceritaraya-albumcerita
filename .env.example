# ── Supabase Connection ─────────────────────────────────────────────────────
# URL of your Supabase instance.
# For self-hosted: e.g. https://supabase.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous key (safe to expose to browser).
# Used by client.ts and server.ts (both currently unused in active code).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — bypasses Row Level Security (RLS).
# NEVER expose to the browser. Used only in Server Actions & Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudeka S3 / Object Storage ────────────────────────────────────────────
# All server-only. NEVER use NEXT_PUBLIC_ prefix for any of these.

# S3-compatible endpoint for Cloudeka StorageGRID
CLOUDEKA_S3_ENDPOINT=

# Region identifier (usually 'kencana' or similar for Cloudeka)
CLOUDEKA_S3_REGION=

# Bucket name
CLOUDEKA_S3_BUCKET=

# Cloudeka access credentials (server-only)
CLOUDEKA_ACCESS_KEY_ID=
CLOUDEKA_SECRET_ACCESS_KEY=

# Optional: Public base URL for the bucket if it has public read access.
# Example: https://kencana.basic.box.cloudeka.id/cerita-raya-storage-0ow553
# If set, getMediaUrl() returns a direct public URL instead of a presigned URL.
# Leave empty if the bucket is private (presigned URLs will be used instead).
CLOUDEKA_PUBLIC_BASE_URL=